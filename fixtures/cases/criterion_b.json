{
  "schema_version": 1,
  "function": "criterion_b",
  "guidelines_version": "2.0",
  "description": [
    "Cross-language conformance cases for IUCN RLE Criterion B.",
    "",
    "Every language binding runs this identical file and must produce identical",
    "output. Categories are compared as their DISPLAY STRINGS, so a range such as",
    "'EN (LC-EN)' is a single exact string comparison in every language and there",
    "is no float tolerance to negotiate.",
    "",
    "Sub-conditions use their Guidelines letters: a = continuing decline,",
    "b = threatening processes, c = few threat-defined locations. Any sub-condition",
    "absent from the list counts as NOT ASSESSED, which is deliberately different",
    "from 'not met'.",
    "",
    "Boundary values come from Guidelines v2.0 Section 6.2, p.66 and mirror the",
    "parametrised table in rle-python tests/test_rle_criteria.py."
  ],
  "cases": [
    {
      "id": "b1.boundary.2000.is_cr",
      "why": "Bounds are inclusive: exactly 2000 km2 meets CR, not EN.",
      "eoo_km2": 2000.0,
      "aoo_cells": null,
      "subconditions": [{ "sub": "a", "status": "met" }],
      "expect": { "b1": "CR", "b2": "NE", "overall": "CR" }
    },
    {
      "id": "b1.boundary.2000_01.is_en",
      "why": "A hair above the CR bound drops to EN.",
      "eoo_km2": 2000.01,
      "aoo_cells": null,
      "subconditions": [{ "sub": "a", "status": "met" }],
      "expect": { "b1": "EN", "b2": "NE", "overall": "EN" }
    },
    {
      "id": "b1.boundary.20000.is_en",
      "eoo_km2": 20000.0,
      "aoo_cells": null,
      "subconditions": [{ "sub": "a", "status": "met" }],
      "expect": { "b1": "EN", "b2": "NE", "overall": "EN" }
    },
    {
      "id": "b1.boundary.20001.is_vu",
      "eoo_km2": 20001.0,
      "aoo_cells": null,
      "subconditions": [{ "sub": "a", "status": "met" }],
      "expect": { "b1": "VU", "b2": "NE", "overall": "VU" }
    },
    {
      "id": "b1.boundary.50000.is_vu",
      "eoo_km2": 50000.0,
      "aoo_cells": null,
      "subconditions": [{ "sub": "a", "status": "met" }],
      "expect": { "b1": "VU", "b2": "NE", "overall": "VU" }
    },
    {
      "id": "b1.boundary.50001.is_lc",
      "why": "Above every bound the criterion is not triggered at all.",
      "eoo_km2": 50001.0,
      "aoo_cells": null,
      "subconditions": [{ "sub": "a", "status": "met" }],
      "expect": { "b1": "LC", "b2": "NE", "overall": "LC" }
    },

    {
      "id": "b2.boundary.2.is_cr",
      "eoo_km2": null,
      "aoo_cells": 2.0,
      "subconditions": [{ "sub": "a", "status": "met" }],
      "expect": { "b1": "NE", "b2": "CR", "overall": "CR" }
    },
    {
      "id": "b2.boundary.3.is_en",
      "eoo_km2": null,
      "aoo_cells": 3.0,
      "subconditions": [{ "sub": "a", "status": "met" }],
      "expect": { "b1": "NE", "b2": "EN", "overall": "EN" }
    },
    {
      "id": "b2.boundary.20.is_en",
      "eoo_km2": null,
      "aoo_cells": 20.0,
      "subconditions": [{ "sub": "a", "status": "met" }],
      "expect": { "b1": "NE", "b2": "EN", "overall": "EN" }
    },
    {
      "id": "b2.boundary.21.is_vu",
      "eoo_km2": null,
      "aoo_cells": 21.0,
      "subconditions": [{ "sub": "a", "status": "met" }],
      "expect": { "b1": "NE", "b2": "VU", "overall": "VU" }
    },
    {
      "id": "b2.boundary.50.is_vu",
      "eoo_km2": null,
      "aoo_cells": 50.0,
      "subconditions": [{ "sub": "a", "status": "met" }],
      "expect": { "b1": "NE", "b2": "VU", "overall": "VU" }
    },
    {
      "id": "b2.boundary.51.is_lc",
      "eoo_km2": null,
      "aoo_cells": 51.0,
      "subconditions": [{ "sub": "a", "status": "met" }],
      "expect": { "b1": "NE", "b2": "LC", "overall": "LC" }
    },

    {
      "id": "gate.unassessed.yields_range",
      "why": "The headline case. Metrics say EN; nobody has checked (a)/(b)/(c); the honest answer spans LC to EN. Nothing in rle-python or redlistr can express this.",
      "eoo_km2": 15000.0,
      "aoo_cells": 15.0,
      "subconditions": [],
      "expect": { "b1": "EN (LC-EN)", "b2": "EN (LC-EN)", "overall": "EN (LC-EN)" }
    },
    {
      "id": "gate.partially_assessed_still_unknown",
      "why": "Two sub-conditions ruled out, the third never examined: still uncertain.",
      "eoo_km2": 15000.0,
      "aoo_cells": null,
      "subconditions": [
        { "sub": "a", "status": "not_met" },
        { "sub": "b", "status": "not_met" }
      ],
      "expect": { "b1": "EN (LC-EN)", "b2": "NE", "overall": "EN (LC-EN)" }
    },
    {
      "id": "gate.all_refuted.is_lc",
      "why": "All three assessed, none met: criterion B is not triggered.",
      "eoo_km2": 15000.0,
      "aoo_cells": 15.0,
      "subconditions": [
        { "sub": "a", "status": "not_met" },
        { "sub": "b", "status": "not_met" },
        { "sub": "c", "status": "not_met" }
      ],
      "expect": { "b1": "LC", "b2": "LC", "overall": "LC" }
    },
    {
      "id": "gate.any_one_met_suffices",
      "why": "Only (c) is met, and that is enough to confirm the listing.",
      "eoo_km2": 15000.0,
      "aoo_cells": null,
      "subconditions": [
        { "sub": "a", "status": "not_met" },
        { "sub": "c", "status": "met" }
      ],
      "expect": { "b1": "EN", "b2": "NE", "overall": "EN" }
    },

    {
      "id": "overall.most_threatened_sub_criterion_governs",
      "why": "EOO is EN, AOO is CR; the overall category follows the worse of the two.",
      "eoo_km2": 15000.0,
      "aoo_cells": 1.0,
      "subconditions": [{ "sub": "b", "status": "met" }],
      "expect": { "b1": "EN", "b2": "CR", "overall": "CR" }
    },
    {
      "id": "overall.unevaluated_sub_criterion_does_not_mask_a_finding",
      "why": "A missing EOO must not drag a real AOO finding down to NE.",
      "eoo_km2": null,
      "aoo_cells": 15.0,
      "subconditions": [{ "sub": "a", "status": "met" }],
      "expect": { "b1": "NE", "b2": "EN", "overall": "EN" }
    },
    {
      "id": "overall.no_metrics_is_not_evaluated",
      "eoo_km2": null,
      "aoo_cells": null,
      "subconditions": [],
      "expect": { "b1": "NE", "b2": "NE", "overall": "NE" }
    },

    {
      "id": "uncertainty.metric_bounds_widen_the_category",
      "why": "EOO plausibly 15000-25000 straddles the EN/VU bound; with (a) met the range is the metric's alone.",
      "eoo_km2": 20000.0,
      "eoo_lower_km2": 15000.0,
      "eoo_upper_km2": 25000.0,
      "aoo_cells": null,
      "subconditions": [{ "sub": "a", "status": "met" }],
      "expect": { "b1": "EN (VU-EN)", "b2": "NE", "overall": "EN (VU-EN)" }
    },
    {
      "id": "uncertainty.metric_and_gate_compose",
      "why": "Uncertain metric AND unassessed sub-conditions: LC becomes plausible on top of the metric's own span.",
      "eoo_km2": 20000.0,
      "eoo_lower_km2": 15000.0,
      "eoo_upper_km2": 25000.0,
      "aoo_cells": null,
      "subconditions": [],
      "expect": { "b1": "EN (LC-EN)", "b2": "NE", "overall": "EN (LC-EN)" }
    }
  ]
}
